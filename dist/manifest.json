{
  "manifest_version": 3,
  "name": "Personal AdBlock",
  "version": "1.0.0",
  "description": "High-performance, privacy-focused personal ad blocker for advertisements, trackers, and intrusive overlays.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Personal AdBlock",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "options_page": "options.html",
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "permissions": [
    "declarativeNetRequest",
    "declarativeNetRequestFeedback",
    "storage",
    "activeTab",
    "tabs",
    "webNavigation"
  ],
  "host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "stealth.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_start"
    }
  ],
  "declarative_net_request": {
    "rule_resources": [
      {
        "id": "ruleset_easylist",
        "enabled": true,
        "path": "rules/easylist.json"
      },
      {
        "id": "ruleset_easyprivacy",
        "enabled": true,
        "path": "rules/easyprivacy.json"
      },
      {
        "id": "ruleset_annoyances",
        "enabled": true,
        "path": "rules/annoyances.json"
      }
    ]
  }
}
